<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Imagen que llena todo el espacio del widget (como estaba originalmente) -->
    <ImageView
        android:id="@+id/widget_image_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Foto del widget completo" />

    <!-- Imagen para formas recortadas (corazón, círculo, estrella, etc.) -->
    <ImageView
        android:id="@+id/widget_image_shaped"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Foto del widget con forma" />

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:padding="16dp"
        android:text="Toca para elegir fotos en la app"
        android:textColor="#FFFFFF"
        android:background="#AA000000"
        android:textSize="14sp"
        android:gravity="center" />

</RelativeLayout>
