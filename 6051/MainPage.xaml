<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_6051.MainPage"
             Title="6051">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="20" RowSpacing="12">

        <Label
            Grid.Row="0"
            Text="Widgets de fotos"
            Style="{StaticResource Headline}"
            HorizontalOptions="Start" />

        <!-- Selector de cuál widget se está editando -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Picker
                Grid.Column="0"
                x:Name="WidgetPicker"
                Title="Elige qué widget configurar"
                SelectedIndexChanged="OnWidgetPickerChanged" />
            <Button
                Grid.Column="1"
                Text="↻"
                Clicked="OnRefreshWidgetsClicked"
                ToolTipProperties.Text="Buscar nuevos widgets en la pantalla"
                WidthRequest="46" />
        </Grid>

        <!-- Selector de forma para el widget actual -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" ColumnSpacing="12">
            <Label
                Grid.Column="0"
                Text="Forma del widget:"
                VerticalOptions="Center"
                FontAttributes="Bold" />
            <Picker
                Grid.Column="1"
                x:Name="ShapePicker"
                Title="Selecciona una forma"
                SelectedIndexChanged="OnShapePickerChanged" />
        </Grid>

        <!-- Botones de acción para el widget seleccionado -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Button
                Grid.Column="0"
                x:Name="AddPhotosBtn"
                Text="+ Agregar fotos"
                Clicked="OnAddPhotosClicked"
                FontAttributes="Bold" />
            <Button
                Grid.Column="1"
                x:Name="ClearPhotosBtn"
                Text="Limpiar"
                Clicked="OnClearPhotosClicked"
                BackgroundColor="#D9534F"
                TextColor="White" />
        </Grid>

        <CollectionView
            Grid.Row="4"
            x:Name="PhotosCollectionView"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10"
                    Padding="20">
                    <Label
                        x:Name="EmptyTitleLabel"
                        Text="Este widget no tiene fotos todavía"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label
                        x:Name="EmptySubtitleLabel"
                        Text="Agrega uno o varios widgets 'Mis Fotos' en tu pantalla de inicio y elígelos arriba para asignarles su forma y sus fotos."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        HeightRequest="180">
                        <Grid>
                            <Image
                                Source="{Binding .}"
                                Aspect="AspectFill" />

                            <Button
                                Text="✕"
                                Clicked="OnRemovePhotoClicked"
                                CommandParameter="{Binding .}"
                                BackgroundColor="#D9534F"
                                TextColor="White"
                                FontSize="12"
                                Padding="8,4"
                                WidthRequest="36"
                                HeightRequest="32"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="6" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
